[user]
	useConfigOnly = true

[core]
	editor = code --wait
	excludesfile = ~/.gitignore_global
	pager = delta

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[merge]
	conflictstyle = zdiff3

[pull]
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rerere]
	enabled = true

[alias]
	br = branch
	co = checkout
	last = log -1 HEAD --stat
	st = status -sb
	tree = log --oneline --decorate --graph --all

[include]
	path = ~/.config/dotfiles/git.local

[includeIf "gitdir:~/personal/"]
	path = ~/.config/dotfiles/git-personal.local

[includeIf "gitdir:~/work/"]
	path = ~/.config/dotfiles/git-work.local